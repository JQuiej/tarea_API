# Copia este archivo como .env y cambia los secretos.
# Genera secretos seguros con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=3000
DB_PATH=./data/soundwave.db

# Deben ser distintos y de al menos 32 caracteres
JWT_ACCESS_SECRET=cambia-este-secreto-de-access-por-uno-aleatorio-largo
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-por-otro-aleatorio-largo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=soundwave-api
JWT_AUDIENCE=soundwave-clients

BCRYPT_ROUNDS=12
# Orígenes permitidos desde navegador (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Usuario administrador que se crea con los datos de demostración
SEED_ADMIN_EMAIL=admin@soundwave.local
SEED_ADMIN_PASSWORD="Admin#2026Seguro"
